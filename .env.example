# 复制成 .env 再改；也可以直接用环境变量覆盖。

# 监听
HOST=0.0.0.0
PORT=8787

# 对外 API Key。留空则自动读/生成 .gateway-key
# CODEARTS_GATEWAY_KEY=sk-xxxxxxxx

# dsh-codearts 包目录；留空自动查找（vendor/ 或 ~/.dsh/profiles/*/node_modules/dsh-codearts）
# CODEARTS_PLUGIN_DIR=C:\Users\me\.dsh\profiles\desktop\node_modules\dsh-codearts

# 模型目录刷新周期（毫秒）
DISCOVERY_INTERVAL_MS=3600000

# 请求体上限（字节）
BODY_LIMIT_BYTES=33554432

# 1 打印逐请求日志，0 关闭
ACCESS_LOG=1
